pipeline {
    agent any

    stages {
        stage('Choose Action') {
            steps {
                script {
                    env.ACTION = input(
                        message: 'What do you want to do?',
                        parameters: [
                            choice(
                                name: 'ACTION',
                                choices: ['deploy', 'destroy'],
                                description: 'Deploy or Destroy infrastructure'
                            )
                        ]
                    )
                }
            }
        }

        stage('Assume Role') {
            steps {
                script {
                    def assumeRoleOutput = sh(
                        script: """
                            aws sts assume-role \
                                --role-arn "arn:aws:iam::529206289534:role/Engineer" \
                                --role-session-name "terraform-${BUILD_NUMBER}" \
                                --duration-seconds 3600 \
                                --query 'Credentials.[AccessKeyId,SecretAccessKey,SessionToken]' \
                                --output text
                        """,
                        returnStdout: true
                    ).trim().split()

                    env.AWS_ACCESS_KEY_ID = assumeRoleOutput[0]
                    env.AWS_SECRET_ACCESS_KEY = assumeRoleOutput[1]
                    env.AWS_SESSION_TOKEN = assumeRoleOutput[2]
                }
            }
        }

        stage('Terraform Init') {
            steps {
                sh 'cd terraform && terraform init -upgrade'
            }
        }

        stage('Terraform Destroy') {
            when {
                expression { env.ACTION == 'destroy' }
            }
            steps {
                sh 'cd terraform && terraform destroy -auto-approve'
            }
        }

        stage('Terraform Plan') {
            when {
                expression { env.ACTION == 'deploy' }
            }
            steps {
                sh 'cd terraform && terraform plan -out=tfplan'
            }
        }

        stage('Review Plan') {
            when {
                expression { env.ACTION == 'deploy' }
            }
            steps {
                input message: 'Review and approve', ok: 'Apply'
            }
        }

        stage('Terraform Apply') {
            when {
                expression { env.ACTION == 'deploy' }
            }
            steps {
                sh 'cd terraform && terraform apply -auto-approve tfplan'
            }
        }

        stage('Output Results') {
            when {
                expression { env.ACTION == 'deploy' }
            }
            steps {
                sh 'cd terraform && terraform output'
            }
        }
    }

    post {
        success {
            slackSend(channel: '#stackjenkins', color: 'good', message: "SUCCESS: ${env.ACTION} completed - ${env.JOB_NAME} [${env.BUILD_NUMBER}]")
        }
        failure {
            slackSend(channel: '#stackjenkins', color: 'danger', message: "FAILED: ${env.ACTION} failed - ${env.JOB_NAME} [${env.BUILD_NUMBER}]")
        }
    }
}
