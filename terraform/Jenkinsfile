pipeline {
    agent any

    stages {
        stage('Confirm Deployment') {
            steps {
                script {
                    input(id: 'confirm', message: 'Deploy CLIXX ECS?', parameters: [
                        [$class: 'BooleanParameterDefinition', defaultValue: false, description: 'Deploy', name: 'confirm']
                    ])
                }
            }
        }

        stage('Assume Role') {
            steps {
                script {
                    def assumeRoleOutput = sh(
                        script: """
                            aws sts assume-role \
                                --role-arn "arn:aws:iam::529206289534:role/Engineer" \
                                --role-session-name "terraform-${BUILD_NUMBER}" \
                                --duration-seconds 3600 \
                                --query 'Credentials.[AccessKeyId,SecretAccessKey,SessionToken]' \
                                --output text
                        """,
                        returnStdout: true
                    ).trim().split()

                    env.AWS_ACCESS_KEY_ID = assumeRoleOutput[0]
                    env.AWS_SECRET_ACCESS_KEY = assumeRoleOutput[1]
                    env.AWS_SESSION_TOKEN = assumeRoleOutput[2]
                }
            }
        }

        stage('Terraform Init') {
            steps {
                sh 'cd terraform && terraform init'
            }
        }

        stage('Terraform Plan') {
            steps {
                sh 'cd terraform && terraform plan -out=tfplan'
            }
        }

        stage('Review Plan') {
            steps {
                input message: 'Review plan and approve', ok: 'Apply'
            }
        }

        stage('Terraform Apply') {
            steps {
                sh 'cd terraform && terraform apply -auto-approve tfplan'
            }
        }

        stage('Outputs') {
            steps {
                sh 'cd terraform && terraform output'
            }
        }
    }

    post {
        success {
            slackSend(channel: '#stackjenkins', color: 'good', message: "SUCCESS: ${env.JOB_NAME} [${env.BUILD_NUMBER}]")
        }
        failure {
            slackSend(channel: '#stackjenkins', color: 'danger', message: "FAILED: ${env.JOB_NAME} [${env.BUILD_NUMBER}]")
        }
    }
}
