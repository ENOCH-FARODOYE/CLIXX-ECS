terraform {
  required_version = ">= 1.0"
  required_providers {
    aws = {
      source  = "hashicorp/aws"
      version = "~> 5.0"
    }
  }
}

provider "aws" {
  region = var.aws_region
}

# Temporary provider to clean up old resources
provider "aws" {
  alias  = "dev"
  region = var.aws_region
}
