pipeline {
    agent any
    stages {
        stage('Confirm Destroy') {
            steps {
                script {
                    input(id: 'confirm', message: 'DESTROY ALL CLIXX INFRASTRUCTURE?', parameters: [
                        [$class: 'BooleanParameterDefinition', defaultValue: false, description: 'Destroy everything', name: 'confirm']
                    ])
                }
            }
        }
        stage('Assume Role') {
            steps {
                script {
                    def assumeRoleOutput = sh(
                        script: """
                            aws sts assume-role \
                                --role-arn "arn:aws:iam::529206289534:role/Engineer" \
                                --role-session-name "terraform-destroy-${BUILD_NUMBER}" \
                                --duration-seconds 3600 \
                                --query 'Credentials.[AccessKeyId,SecretAccessKey,SessionToken]' \
                                --output text
                        """,
                        returnStdout: true
                    ).trim().split()
                    env.AWS_ACCESS_KEY_ID = assumeRoleOutput[0]
                    env.AWS_SECRET_ACCESS_KEY = assumeRoleOutput[1]
                    env.AWS_SESSION_TOKEN = assumeRoleOutput[2]
                }
            }
        }
        stage('Terraform Init') {
            steps {
                sh 'cd terraform && terraform init -upgrade'
            }
        }
        stage('Terraform Destroy') {
            steps {
                sh 'cd terraform && terraform destroy -auto-approve'
            }
        }
    }
    post {
        success {
            slackSend(channel: '#stackjenkins', color: 'good', message: "SUCCESS: CLIXX infrastructure destroyed - ${env.JOB_NAME} [${env.BUILD_NUMBER}]")
        }
        failure {
            slackSend(channel: '#stackjenkins', color: 'danger', message: "FAILED: Terraform destroy failed - ${env.JOB_NAME} [${env.BUILD_NUMBER}]")
        }
    }
}
